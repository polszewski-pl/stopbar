{
  "name": "stopbar",
  "version": "1.1.2",
  "description": "A formally proven execution gate for AI coding agents: hooks for Claude Code, Cursor, Codex CLI, Gemini CLI and Antigravity CLI, plus git hooks. No commit without a passing build and full test suite, no silent test weakening, no exfiltration after a secret read.",
  "author": "Paweł Olszewski <kontakt@polszewski.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polszewski-pl/stopbar.git"
  },
  "homepage": "https://github.com/polszewski-pl/stopbar#readme",
  "bugs": {
    "url": "https://github.com/polszewski-pl/stopbar/issues"
  },
  "type": "module",
  "bin": {
    "stopbar": "bin/stopbar.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/kernel.ts",
    "claude-hooks.example.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node scripts/build.ts && node tests/run-all.ts",
    "test:fuzz": "node tests/stateful-wrapper.ts",
    "test:e2e": "node tests/e2e.ts",
    "prove": "node scripts/build.ts && node bin/stopbar.mjs prove",
    "verify": "node scripts/build.ts && node bin/stopbar.mjs prove",
    "verify:lean": "node scripts/build.ts && node scripts/verify-lean.ts",
    "probe": "node scripts/build.ts && node bin/stopbar.mjs probe",
    "bench": "node bench/hook-latency.ts",
    "prepack": "node scripts/build.ts"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "antigravity",
    "ai-agents",
    "hooks",
    "coding-agent",
    "guardrails",
    "formal-verification",
    "git"
  ],
  "dependencies": {
    "gdp-wired": "0.60.0"
  }
}
